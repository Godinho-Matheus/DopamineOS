# Exemplo de variáveis de ambiente do backend LumeOS.
# Copie para `.env` (NÃO versionado) e preencha com valores reais.
# NUNCA versione segredos reais (RNF-14). Este arquivo contém apenas placeholders.

# Perfil Spring ativo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Banco de dados PostgreSQL (a URL é montada como jdbc:postgresql://DB_HOST:DB_PORT/DB_NAME)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
# Em desenvolvimento, defina a senha do seu PostgreSQL local aqui.
DB_PASSWORD=changeme

# JWT (usado a partir da task 1.2; aqui apenas as chaves ficam presentes na config)
# Segredo forte (>= 256 bits). Gere um valor aleatório; nunca commite o valor real.
JWT_SECRET=
# TTL do token em segundos
JWT_TTL=3600

# Cookie de sessão Secure (true em produção/HTTPS, false em dev/HTTP)
COOKIE_SECURE=false

# Origens CORS permitidas (lista separada por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200
